# Supabase Environment Variables
# Replace these with your own Supabase project credentials
# Get them from: https://supabase.com/dashboard -> Settings -> API

VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ YOUR_PUBLIC_KEY"

# Server-side Supabase configuration
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_ YOUR_PUBLIC_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Application configuration
GYM_NAME="Your Gym Name"
GYM_CURRENCY="₹"
GYM_COUNTRY_CODE="91"
GYM_CONTACT_NUMBER="+910000000000"

# Security / Cron
CRON_SECRET="your_cron_secret_here"